reports/*.raw.json

# Asset de démo (secrets factices) - jamais commité, copié manuellement
# uniquement au moment de la démo live sur une branche dédiée
demo-assets/

# Mots de passe générés par la rotation automatisée — jamais versionnés
secrets-rotation/