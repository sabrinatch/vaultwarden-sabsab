# Secrets et configuration locale
.env
*.env
!.env.example
.env.runtime

# Données persistantes (contiennent le coffre chiffré, ne pas versionner)
data/

# Fichiers macOS
.DS_Store

# Sauvegardes chiffrées et clé privée (brique 5)
backups/*.tar.gz
backups/*.tar.gz.age
scripts/age-private-key.txt

# Rapports générés (brique 6) — on décidera plus tard si on en versionne
