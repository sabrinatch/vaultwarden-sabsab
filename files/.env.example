# Copie ce fichier en ".env" avant de lancer le projet :
#   cp .env.example .env
#
# Le fichier ".env" ne doit JAMAIS être commité (il est dans .gitignore).
# C'est précisément le genre de fichier que l'audit de sécurité (brique 2)
# doit vérifier comme absent du dépôt Git.

DOMAIN=localhost

# ADMIN_TOKEN doit être un HASH Argon2 (PHC string), pas un mot de passe en clair.
# Génère-le avec la commande suivante une fois Docker installé :
#
#   docker run --rm -it vaultwarden/server /vaultwarden hash
#
# Elle te demandera un mot de passe et affichera un hash du type :
#   $argon2id$v=19$m=65540,t=3,p=4$....
#
# Colle ce hash tel quel ci-dessous (garde les guillemets si présents).
ADMIN_TOKEN=REMPLACE_MOI_PAR_UN_HASH_ARGON2
